# Copy to .env and fill locally. Never commit real values.
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
JARVIS_MODEL=openai/gpt-oss-120b
JARVIS_MAX_RETRIES=3
JARVIS_MAX_CONTEXT=12
JARVIS_MAX_TOOL_STEPS=4
JARVIS_REQUIRE_RESEARCH=1
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Optional: choose a model already installed in Ollama. Jarvis never downloads models itself.
JARVIS_LOCAL_MODEL=
